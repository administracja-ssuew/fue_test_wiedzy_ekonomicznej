# FUE Quiz — Environment Variables
# Copy to .env.local and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── SETUP CHECKLIST ───────────────────────────────────────────
# 1. Create Supabase project at https://supabase.com
# 2. Auth → Settings → JWT Expiry → set to 14400 (4 hours)
# 3. SQL Editor → paste contents of SUPABASE_SCHEMA.sql → Run
# 4. Copy this file to .env.local and fill in values above
# 5. Register first user, then run SQL to promote to admin:
#    UPDATE public.profiles SET role = 'global_admin' WHERE id = 'YOUR_UUID';
